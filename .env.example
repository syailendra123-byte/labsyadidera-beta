# ============================================
# TEMPLATE ENV VARIABLE
# ============================================
# File ini AMAN di-push ke GitHub (cuma contoh nama variable, bukan nilai asli)
# Copy file ini jadi ".env" di lokal, terus isi dengan value asli
# JANGAN PERNAH commit file ".env" ke GitHub!

# --- Google OAuth ---
# Ambil dari: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=isi-dengan-client-id-google-lo
GOOGLE_CLIENT_SECRET=isi-dengan-client-secret-google-lo

# --- GitHub OAuth ---
# Ambil dari: https://github.com/settings/developers
GITHUB_CLIENT_ID=isi-dengan-client-id-github-lo
GITHUB_CLIENT_SECRET=isi-dengan-client-secret-github-lo

# --- Session Secret ---
# String random buat enkripsi session, bebas isi apa aja asal panjang & acak
# Generate gampang pakai: openssl rand -base64 32
SESSION_SECRET=isi-dengan-string-random-yang-panjang

# --- URL Aplikasi ---
# Waktu di lokal, biasanya http://localhost:3000
# Waktu udah di-deploy Vercel, ganti ke URL Vercel lo, misal https://project-lo.vercel.app
APP_URL=http://localhost:3000
